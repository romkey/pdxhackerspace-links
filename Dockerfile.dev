# syntax=docker/dockerfile:1

ARG RUBY_VERSION=4.0.10
ARG NODE_VERSION=26.13.1

FROM node:${NODE_VERSION}-bookworm-slim AS node
RUN npm install -g yarn@1.22.22

FROM ruby:${RUBY_VERSION}-slim

WORKDIR /rails

RUN apt-get update -qq && \
    apt-get install --no-install-recommends -y build-essential curl cups-client git libpq-dev libpoppler-glib8 libusb-1.0-0 libvips poppler-utils libyaml-dev pkg-config python-is-python3 && \
    rm -rf /var/lib/apt/lists /var/cache/apt/archives

COPY --from=node /usr/local/ /opt/node/
ENV PATH=/opt/node/bin:$PATH

ENV BUNDLE_PATH=/usr/local/bundle

COPY Gemfile Gemfile.lock ./
RUN bundle install

COPY package.json yarn.lock ./
RUN yarn install --frozen-lockfile

COPY . .

ENTRYPOINT ["/rails/bin/docker-entrypoint"]
EXPOSE 3000
CMD ["./bin/dev"]
