<% if source.syncing? %>
  <span class="badge text-bg-secondary-subtle text-12 fw-normal">Running</span>
<% elsif source.last_sync_skipped? %>
  <span class="badge text-bg-secondary-subtle text-12 fw-normal" title="<%= source.last_sync_message %>">Skipped</span>
<% elsif source.last_synced_at.blank? %>
  <span class="text-secondary text-13">Never</span>
<% else %>
  <span class="text-13">
    <% if source.last_sync_ok? %>
      <span class="status-dot status-success" title="Last import succeeded"></span>
    <% elsif source.last_sync_failed? %>
      <span class="badge text-bg-danger-subtle text-12 fw-normal">Failed</span>
    <% else %>
      <span class="badge text-bg-warning-subtle text-12 fw-normal">Partial</span>
    <% end %>
    <span class="text-secondary" title="<%= source.last_synced_at.to_fs(:long) %>">
      <%= time_ago_in_words(source.last_synced_at) %> ago
    </span>
  </span>
<% end %>
