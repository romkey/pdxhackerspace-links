<nav class="settings-nav">
  <div class="settings-nav-item settings-nav-heading">Settings</div>
  <%= link_to "General", settings_site_path, class: settings_nav_class(:site) %>
  <%= link_to "Scan visits", settings_scan_visits_path, class: settings_nav_class(:scan_visits) %>
  <%= link_to "Printers", settings_printers_path, class: settings_nav_class(:printers) %>
  <div class="settings-nav-item settings-nav-heading mt-2">Integrations</div>
  <% Integrations::Registry.all.each do |entry| %>
    <%= link_to entry.label, send(entry.settings_path), class: settings_nav_class(entry.key) %>
  <% end %>
</nav>
