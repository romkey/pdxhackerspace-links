<% content_for :title, title %>

<%= settings_frame do %>
  <div class="mb-3">
    <div class="text-12 text-secondary mb-1">
      <%= link_to "Zigbee2MQTT", settings_zigbee2mqtt_bridges_path, class: "text-secondary text-decoration-none" %>
      <span class="mx-1">/</span>
      <span class="text-body"><%= title %></span>
    </div>
    <h1 class="h-page-title mb-0"><%= title %></h1>
  </div>

  <%= form_with model: zigbee2mqtt_bridge,
                url: zigbee2mqtt_bridge.persisted? ? settings_zigbee2mqtt_bridge_path(zigbee2mqtt_bridge) : settings_zigbee2mqtt_bridges_path,
                class: "vstack gap-4" do |form| %>
    <% if zigbee2mqtt_bridge.errors.any? %>
      <div class="alert alert-danger text-13">
        <%= zigbee2mqtt_bridge.errors.full_messages.to_sentence %>
      </div>
    <% end %>

    <div class="row g-3">
      <div class="col-md-6">
        <%= form.label :name, "Display name", class: "form-label" %>
        <%= form.text_field :name, class: "form-control", required: true, placeholder: "Workshop Zigbee" %>
      </div>
      <div class="col-12">
        <%= form.label :description, class: "form-label" %>
        <%= form.text_area :description, class: "form-control", rows: 2,
                           placeholder: "Which broker this connects to and what it covers." %>
      </div>
    </div>

    <div>
      <div class="h-section-label mb-2">MQTT broker</div>
      <div class="row g-3">
        <div class="col-md-6">
          <%= form.label :mqtt_host, "Host", class: "form-label" %>
          <%= form.text_field :mqtt_host, class: "form-control", required: true, placeholder: "192.168.1.50" %>
        </div>
        <div class="col-md-3">
          <%= form.label :mqtt_port, "Port", class: "form-label" %>
          <%= form.number_field :mqtt_port, class: "form-control", min: 1, max: 65_535 %>
        </div>
        <div class="col-md-6">
          <%= form.label :base_topic, "Base topic", class: "form-label" %>
          <%= form.text_field :base_topic, class: "form-control", required: true %>
        </div>
        <div class="col-md-6">
          <%= form.label :mqtt_username, "Username", class: "form-label" %>
          <%= form.text_field :mqtt_username, class: "form-control", autocomplete: "off" %>
        </div>
        <div class="col-md-6">
          <%= form.label :mqtt_password, "Password", class: "form-label" %>
          <%= form.password_field :mqtt_password, class: "form-control font-monospace text-12",
                                  autocomplete: "off",
                                  placeholder: zigbee2mqtt_bridge.persisted? ? "Leave blank to keep the current password" : "" %>
        </div>
        <div class="col-12">
          <div class="form-check">
            <%= form.check_box :mqtt_tls, class: "form-check-input" %>
            <%= form.label :mqtt_tls, "Use TLS", class: "form-check-label" %>
          </div>
        </div>
      </div>
    </div>

    <div>
      <div class="h-section-label mb-2">Import options</div>
      <div class="row g-3">
        <div class="col-md-4">
          <%= form.label :last_seen_limit_days, "Recently seen within (days)", class: "form-label" %>
          <%= form.number_field :last_seen_limit_days, class: "form-control", min: 1, placeholder: "No limit" %>
          <div class="form-text text-12">Leave blank to import every device on the bridge.</div>
        </div>
        <div class="col-12">
          <div class="form-check">
            <%= form.check_box :skip_disabled_devices, class: "form-check-input" %>
            <%= form.label :skip_disabled_devices, "Skip disabled devices", class: "form-check-label" %>
          </div>
        </div>
        <div class="col-12">
          <div class="form-check">
            <%= form.check_box :import_unknown_last_seen, class: "form-check-input" %>
            <%= form.label :import_unknown_last_seen, "Import devices with unknown last_seen", class: "form-check-label" %>
          </div>
          <div class="form-text text-12">
            <code class="text-12">last_seen</code> is only published when
            <code class="text-12">advanced.last_seen</code> is enabled in Zigbee2MQTT and state messages are retained.
            Turn this off to skip devices with no recency data when a day limit is set.
          </div>
        </div>
      </div>
    </div>

    <div>
      <div class="h-section-label mb-2">Things</div>
      <div class="form-check">
        <%= form.check_box :auto_create_things, class: "form-check-input" %>
        <%= form.label :auto_create_things, "Create a thing for each new device", class: "form-check-label" %>
      </div>
      <div class="form-text text-12">
        Devices always match an existing thing by IEEE address first. Names, manufacturer, model, and manufacturer links
        stay in sync until you edit them by hand.
      </div>
    </div>

    <div>
      <div class="h-section-label mb-2">Status</div>
      <div class="form-check">
        <%= form.check_box :enabled, class: "form-check-input" %>
        <%= form.label :enabled, "Enabled", class: "form-check-label" %>
      </div>
      <div class="form-text text-12">Disabled bridges are skipped by scheduled imports.</div>
    </div>

    <div class="d-flex gap-2">
      <%= form.submit class: "btn btn-primary btn-sm" %>
      <%= link_to "Cancel",
                  zigbee2mqtt_bridge.persisted? ? settings_zigbee2mqtt_bridge_path(zigbee2mqtt_bridge) : settings_zigbee2mqtt_bridges_path,
                  class: "btn btn-outline-secondary btn-sm" %>
      <% if zigbee2mqtt_bridge.persisted? %>
        <%= button_to "Delete", settings_zigbee2mqtt_bridge_path(zigbee2mqtt_bridge), method: :delete,
                      class: "btn btn-outline-danger btn-sm",
                      form: { data: { turbo_confirm: "Delete #{zigbee2mqtt_bridge.name}? Imported things are kept." } } %>
      <% end %>
    </div>
  <% end %>
<% end %>
