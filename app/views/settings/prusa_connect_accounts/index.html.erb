<% content_for :title, "Prusa Connect" %>

<%= settings_frame do %>
  <div class="d-flex align-items-end justify-content-between mb-3">
    <div>
      <h1 class="h-page-title mb-0">Prusa Connect</h1>
      <div class="text-13 text-secondary mt-1">
        <span class="text-body"><%= @prusa_connect_accounts.size %></span> <%= "account".pluralize(@prusa_connect_accounts.size) %> ·
        <span class="<%= PrusaConnectPrinter.active.count.zero? ? "text-secondary" : "text-body" %>"><%= PrusaConnectPrinter.active.count %></span> printers imported
      </div>
    </div>
    <div>
      <%= link_to "+ Add account", new_settings_prusa_connect_account_path, class: "btn btn-primary btn-sm" %>
    </div>
  </div>

  <% if @prusa_connect_accounts.any? %>
    <div class="table-responsive">
      <table class="table table-compact table-hover align-middle mb-0">
        <thead>
          <tr>
            <th>Name</th>
            <th class="num">Printers</th>
            <th>Last import</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% @prusa_connect_accounts.each do |account| %>
            <tr class="clickable-row" data-href="<%= settings_prusa_connect_account_path(account) %>">
              <td class="fw-medium"><%= account.name %></td>
              <td class="num <%= account.printer_count.zero? ? "text-secondary" : "" %>"><%= account.printer_count %></td>
              <td><%= render "settings/integrations/sync_status", source: account %></td>
              <td class="text-end">
                <%= link_to "Edit", edit_settings_prusa_connect_account_path(account), class: "btn btn-outline-secondary btn-sm" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p class="text-secondary text-13 mb-2">
      No Prusa Connect accounts yet. Add one to import your cloud printers as things.
    </p>
    <p class="text-secondary text-12 mb-0">
      Sign in at connect.prusa3d.com, copy the refresh token from browser local storage, and paste it here.
    </p>
  <% end %>
<% end %>

<script>
  document.querySelectorAll(".clickable-row").forEach((row) => {
    row.addEventListener("click", (event) => {
      if (event.target.closest("a, button")) return;
      window.location = row.dataset.href;
    });
  });
</script>
