<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
  <head>
    <title><%= content_for(:title) || "Links" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <%= render "shared/matomo_tracking" %>
  </head>

  <body class="d-flex flex-column min-vh-100">
    <% if show_navigation? %>
      <nav class="navbar navbar-expand-lg border-bottom border-secondary-subtle">
        <div class="container-fluid">
          <% if public_guest? %>
            <span class="navbar-brand">Links</span>
            <div class="d-flex align-items-center gap-2 ms-auto">
              <%= link_to "Sign in", login_path, class: "btn btn-outline-secondary btn-sm" %>
            </div>
          <% else %>
            <%= link_to "Links", root_path, class: "navbar-brand" %>
            <button class="navbar-toggler btn btn-outline-secondary btn-sm ms-2"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#navbarNav"
                    aria-controls="navbarNav"
                    aria-expanded="false"
                    aria-label="Toggle navigation">
              <i class="bi bi-list"></i>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
              <div class="d-flex flex-column flex-lg-row align-items-lg-center gap-2 ms-lg-3 mt-2 mt-lg-0">
                <%= link_to "Things", things_path, class: "btn btn-outline-secondary btn-sm" %>
                <% if logged_in? %>
                  <%= link_to "Settings", settings_root_path, class: "btn btn-outline-secondary btn-sm" %>
                <% end %>
              </div>
              <div class="d-flex align-items-center gap-2 ms-lg-auto mt-2 mt-lg-0">
                <% if logged_in? %>
                  <span class="text-secondary text-13"><%= current_user.name %></span>
                  <%= button_to "Sign out", logout_path, method: :delete, class: "btn btn-outline-secondary btn-sm" %>
                <% else %>
                  <%= link_to "Sign in", login_path, class: "btn btn-outline-secondary btn-sm" %>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      </nav>
    <% end %>

    <main class="flex-grow-1">
      <% flash.each do |type, message| %>
        <div class="container-fluid mt-3">
          <div class="alert alert-<%= bootstrap_class_for(type) %> alert-dismissible fade show py-2" role="alert">
            <%= message %>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
          </div>
        </div>
      <% end %>

      <%= yield %>
    </main>

    <footer class="border-top border-secondary-subtle py-2 mt-auto">
      <div class="container-fluid d-flex justify-content-between align-items-center text-12 text-secondary">
        <%= link_to "GitHub", github_repo_url, class: "text-secondary", target: "_blank", rel: "noopener" %>
        <%= link_to app_version_display,
                    github_version_url,
                    class: "text-secondary",
                    title: "View on GitHub",
                    target: "_blank",
                    rel: "noopener" %>
      </div>
    </footer>
  </body>
</html>
