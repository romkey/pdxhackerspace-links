<div class="form-section"
     data-controller="thing-picker"
     data-thing-picker-search-url-value="<%= search_things_path(format: :json) %>"
     data-thing-picker-exclude-id-value="<%= thing.id %>"
     data-thing-picker-select-url-template-value="<%= merge_thing_path(thing, source_id: "__SOURCE__") %>">
  <div class="h-section-label mb-2">Thing to merge in</div>
  <p class="text-secondary text-13 mb-3">
    Its photos, links, related things, and imported devices move onto <span class="text-body"><%= thing.name %></span>,
    and its short link keeps working. You choose what to do with any field the two disagree on.
  </p>

  <div class="position-relative" style="max-width: 32rem;">
    <label class="form-label" for="merge-source-search">Search things</label>
    <input type="search"
           id="merge-source-search"
           class="form-control"
           placeholder="Search by name, key, or address…"
           autocomplete="off"
           data-thing-picker-target="input"
           data-action="input->thing-picker#input keydown->thing-picker#keydown">
    <div class="list-group position-absolute w-100 d-none shadow-sm"
         style="z-index: 1050; max-height: 240px; overflow-y: auto;"
         data-thing-picker-target="results"></div>
  </div>
</div>

<div class="d-flex gap-2 mt-3">
  <%= link_to "Cancel", thing_path(thing), class: "btn btn-outline-secondary btn-sm" %>
</div>
