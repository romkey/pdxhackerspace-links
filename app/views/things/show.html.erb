<% content_for :title, @thing.name %>

<%= tag.div class: "container-fluid py-4",
            data: things_show_container_data.merge(
              controller: [ things_show_container_data[:controller], "lightbox" ].compact.join(" ")
            ) do %>
  <div class="mb-3">
    <div class="text-12 text-secondary mb-1">
      <% if logged_in? || network_guest? %>
        <%= link_to "Things", things_path, class: "text-secondary text-decoration-none" %>
        <span class="mx-1">/</span>
      <% end %>
      <span class="text-body"><%= @thing.name %></span>
    </div>
    <div class="d-flex align-items-start justify-content-between gap-3">
      <div class="flex-grow-1 min-w-0">
        <h1 class="h-page-title mb-0"><%= @thing.name %></h1>
        <% if can_manage_things? && @thing.public_access? %>
          <span class="badge text-bg-secondary-subtle text-12 fw-normal mt-1">Public</span>
        <% end %>
        <% if (subtitle = things_subtitle_line(@thing)).present? %>
          <div class="text-13 text-secondary mt-1"><%= subtitle %></div>
        <% end %>
        <div class="text-12 text-secondary mt-1">
          Created <%= relative_time(@thing.created_at) %>
          · Updated <%= relative_time(@thing.updated_at) %>
        </div>
      </div>
    </div>
  </div>

  <%= render "show_actions", thing: @thing, printers: @printers %>

  <% if @tracked_redirect %>
    <div class="status-panel status-attention mb-3 text-13"
         data-controller="redirect-countdown"
         data-redirect-countdown-url-value="<%= @tracked_redirect[:url] %>"
         data-redirect-countdown-seconds-value="<%= @tracked_redirect[:seconds] %>">
      Redirecting to <%= link_to @tracked_redirect[:title], @tracked_redirect[:url], class: "fw-medium" %>
      in <span data-redirect-countdown-target="countdown"><%= @tracked_redirect[:seconds] %></span> seconds…
    </div>
  <% end %>

  <%= render "where", thing: @thing %>

  <div class="row g-4 mb-4">
    <div class="col-lg-7">
      <% if @thing.description.present? %>
        <div class="prose"><%= simple_format(@thing.description) %></div>
      <% end %>

      <% if @thing.notes.present? %>
        <div class="mt-3">
          <div class="h-section-label mb-2">Notes</div>
          <div class="prose"><%= simple_format(@thing.notes) %></div>
        </div>
      <% end %>
    </div>

    <div class="col-lg-5">
      <%= render "photo_hero", thing: @thing %>

      <% if (logged_in? || network_guest?) && @thing.related_things_for_display.any? %>
        <%= render "related_things", thing_relationships: @thing.related_things_for_display %>
      <% end %>
    </div>
  </div>

  <% if @thing.photos.size > 1 %>
    <div class="thing-photo-grid row g-2 mb-4">
      <% @thing.photos.drop(1).each do |photo| %>
        <% thumb_dims = things_photo_dimensions(photo, max_width: 200) %>
        <div class="col-6 col-md-4 col-lg-3">
          <%= link_to "#",
                      data: {
                        action: "lightbox#open",
                        lightbox_url_value: things_photo_source(photo, :hero)
                      } do %>
            <%= image_tag things_photo_source(photo, :thumb),
                          class: "img-fluid rounded border border-secondary-subtle w-100",
                          loading: "lazy",
                          alt: @thing.name,
                          **thumb_dims %>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>

  <%= render "links_grid", thing: @thing %>

  <%= render "technical_details", thing: @thing %>

  <%= render "admin_footer",
             thing: @thing,
             unifi_devices: @unifi_devices,
             zigbee2mqtt_devices: @zigbee2mqtt_devices %>

  <div class="modal fade" tabindex="-1" data-lightbox-target="modal" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
      <div class="modal-content bg-dark">
        <div class="modal-body p-2 text-center">
          <img src="" alt="" class="img-fluid" data-lightbox-target="image">
        </div>
      </div>
    </div>
  </div>

  <% if can_manage_things? && @printers.present? %>
    <%= render "print_dialog", printers: @printers %>
  <% end %>
<% end %>
