<div class="d-flex flex-wrap align-items-center gap-2 mb-2">
  <button type="button"
          class="btn btn-outline-secondary btn-sm"
          data-bs-toggle="offcanvas"
          data-bs-target="#things-filters-offcanvas"
          aria-controls="things-filters-offcanvas">
    Filters
    <% if @things_index.filters.active? %>
      <span class="badge text-bg-secondary-subtle ms-1"><%= @things_index.filters.active_count %></span>
    <% end %>
  </button>

  <% if @things_index.filters.active? %>
    <%= things_active_filter_pills %>
    <%= link_to "Clear", things_clear_filters_path, class: "text-12 text-secondary text-decoration-none" %>
  <% end %>

  <% if can_manage_things? %>
    <div class="dropdown ms-lg-auto">
      <button type="button"
              class="btn btn-outline-secondary btn-sm dropdown-toggle"
              data-bs-toggle="dropdown"
              aria-expanded="false">
        Columns
      </button>
      <ul class="dropdown-menu dropdown-menu-end">
        <% ThingsHelper::THINGS_OPTIONAL_COLUMNS.each do |column| %>
          <li>
            <%= link_to things_column_toggle_path(column),
                        class: "dropdown-item #{'active' if things_column_visible?(column)}" do %>
              <% if things_column_visible?(column) %>
                <i class="bi bi-check-lg text-11 me-1"></i>
              <% else %>
                <span class="d-inline-block text-11 me-1" style="width: 1rem;"></span>
              <% end %>
              <%= ThingsHelper::THINGS_COLUMN_LABELS[column] %>
            <% end %>
          </li>
        <% end %>
      </ul>
    </div>
  <% end %>
</div>

<div class="offcanvas offcanvas-start offcanvas-lg" tabindex="-1" id="things-filters-offcanvas" aria-labelledby="things-filters-offcanvas-label">
  <div class="offcanvas-header py-2">
    <h2 class="offcanvas-title h6 mb-0" id="things-filters-offcanvas-label">Filters</h2>
    <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
  </div>
  <div class="offcanvas-body pt-0">
    <%= render "things/filters_list" %>
    <% if @things_index.filters.active? %>
      <div class="mt-3">
        <%= link_to "Clear filters", things_clear_filters_path, class: "btn btn-outline-secondary btn-sm" %>
      </div>
    <% end %>
  </div>
</div>
