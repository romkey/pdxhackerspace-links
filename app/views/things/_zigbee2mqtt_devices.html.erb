<div class="h-section-label mb-2">Zigbee2MQTT</div>
<div class="vstack gap-3 mb-4">
  <% zigbee2mqtt_devices.each do |device| %>
    <div class="sidebar-card">
      <div class="d-flex justify-content-between align-items-start gap-2">
        <div class="fw-medium text-13"><%= device.device_type_label %></div>
        <% if device.archived? %>
          <span class="badge text-bg-warning-subtle text-11 fw-normal">Not seen</span>
        <% elsif device.disabled? %>
          <span class="badge text-bg-secondary-subtle text-11 fw-normal">Disabled</span>
        <% end %>
      </div>
      <dl class="row text-12 mb-0 mt-2">
        <dt class="col-5 text-secondary">Bridge</dt>
        <dd class="col-7"><%= link_to device.zigbee2mqtt_bridge.name, settings_zigbee2mqtt_bridge_path(device.zigbee2mqtt_bridge) %></dd>
        <% if device.manufacturer.present? %>
          <dt class="col-5 text-secondary">Manufacturer</dt>
          <dd class="col-7"><%= device.manufacturer %></dd>
        <% end %>
        <% if device.model.present? %>
          <dt class="col-5 text-secondary">Model</dt>
          <dd class="col-7"><%= device.model %></dd>
        <% end %>
        <dt class="col-5 text-secondary">IEEE address</dt>
        <dd class="col-7"><code class="text-12"><%= Integrations::HardwareAddress.display(device.ieee_address) %></code></dd>
        <dt class="col-5 text-secondary">Last seen</dt>
        <dd class="col-7 text-secondary" title="<%= device.last_seen_at.to_fs(:long) %>">
          <%= time_ago_in_words(device.last_seen_at) %> ago
        </dd>
      </dl>
    </div>
  <% end %>
</div>
