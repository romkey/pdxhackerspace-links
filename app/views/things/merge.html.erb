<% content_for :title, "Merge into #{@thing.name}" %>

<div class="container-fluid py-4">
  <div class="mb-3">
    <div class="text-12 text-secondary mb-1">
      <%= link_to "Things", things_path, class: "text-secondary text-decoration-none" %>
      <span class="mx-1">/</span>
      <%= link_to @thing.name, thing_path(@thing), class: "text-secondary text-decoration-none" %>
      <span class="mx-1">/</span>
      <span class="text-body">Merge</span>
    </div>
    <h1 class="h-page-title mb-0">Merge into <%= @thing.name %></h1>
    <div class="text-13 text-secondary mt-1">
      <% if @merge_source %>
        Folding in <span class="text-body"><%= @merge_source.name %></span>
      <% else %>
        Pick the duplicate to fold into this thing
      <% end %>
    </div>
  </div>

  <% if @merge_source %>
    <%= render "merge_resolution", thing: @thing, source: @merge_source, plan: @merge_plan %>
  <% else %>
    <%= render "merge_picker", thing: @thing %>
  <% end %>
</div>
