<% last = index == thing_form_steps.size - 1 %>
<div class="wizard-footer d-flex flex-wrap gap-2">
  <% if index.positive? %>
    <button type="button" class="btn btn-outline-secondary btn-sm" data-action="thing-wizard#back">Back</button>
  <% end %>
  <% unless last %>
    <button type="button" class="btn btn-outline-primary btn-sm" data-action="thing-wizard#next">Next</button>
  <% end %>
  <% if last || thing.persisted? %>
    <%= form.submit "Save and Exit", class: "btn btn-primary btn-sm" %>
  <% end %>
  <div class="ms-auto d-flex gap-2">
    <%= link_to "Cancel", thing.persisted? ? thing_path(thing) : things_path, class: "btn btn-outline-secondary btn-sm" %>
    <% if thing.persisted? %>
      <%= link_to "Delete", thing_path(thing),
                  class: "btn btn-outline-danger btn-sm",
                  data: { turbo_method: :delete, turbo_confirm: "Delete #{thing.name}?" } %>
    <% end %>
  </div>
</div>
