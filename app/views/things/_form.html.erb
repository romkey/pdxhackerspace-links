<%= form_with model: thing, class: "vstack gap-4", html: { multipart: true } do |form| %>
  <% if thing.errors.any? %>
    <div class="alert alert-danger text-13">
      <%= thing.errors.full_messages.to_sentence %>
    </div>
  <% end %>

  <div>
    <div class="h-section-label mb-2">Identity</div>
    <div class="row g-3">
      <div class="col-md-6">
        <%= form.label :name, class: "form-label" %>
        <%= form.text_field :name, class: "form-control", required: true %>
      </div>
      <div class="col-md-6">
        <%= form.label :owner, class: "form-label" %>
        <%= form.text_field :owner, class: "form-control", placeholder: "Optional" %>
      </div>
      <div class="col-md-6">
        <%= form.label :slug, class: "form-label" %>
        <%= form.text_field :slug, class: "form-control", placeholder: "Optional" %>
        <div class="form-text text-12">Optional short URL path, e.g. /things/front-door-keyboard</div>
      </div>
      <div class="col-md-6">
        <%= form.label :ip_address, "IP address", class: "form-label" %>
        <%= form.text_field :ip_address, class: "form-control", placeholder: "192.168.1.10" %>
      </div>
      <div class="col-md-6">
        <%= form.label :hostname, class: "form-label" %>
        <%= form.text_field :hostname, class: "form-control", placeholder: "host.example.com" %>
      </div>
      <div class="col-md-6">
        <%= form.label :ieee_address, "IEEE address", class: "form-label" %>
        <%= form.text_field :ieee_address, class: "form-control", placeholder: "94:2a:6f:26:c6:ca or 0x90fd9ffffe6494fc" %>
        <div class="form-text text-12">Optional. Used to match this thing to an imported device.</div>
      </div>
      <div class="col-md-6">
        <%= form.label :manufacturer, class: "form-label" %>
        <%= form.text_field :manufacturer, class: "form-control", placeholder: "Optional" %>
      </div>
      <div class="col-md-6">
        <%= form.label :model, class: "form-label" %>
        <%= form.text_field :model, class: "form-control", placeholder: "Optional" %>
      </div>
      <div class="col-md-6">
        <%= form.label :manufacturer_url, "Manufacturer link", class: "form-label" %>
        <%= form.url_field :manufacturer_url, class: "form-control", placeholder: "https://" %>
      </div>
      <div class="col-md-6">
        <%= form.label :ble_beacon_uuid, "BLE beacon UUID", class: "form-label" %>
        <%= form.text_field :ble_beacon_uuid, class: "form-control", placeholder: "fda50693-f4c2-4a1b-8fb9-9d9458836f36" %>
        <div class="form-text text-12">Optional iBeacon UUID for lookup at /things/by_beacon/&lt;uuid&gt;</div>
      </div>
      <div class="col-12">
        <%= form.label :description, class: "form-label" %>
        <%= form.text_area :description, class: "form-control", rows: 4 %>
      </div>
      <div class="col-12">
        <%= form.label :notes, class: "form-label" %>
        <%= form.text_area :notes, class: "form-control", rows: 3, placeholder: "Optional" %>
      </div>
      <div class="col-12">
        <div class="form-check">
          <%= form.check_box :public_access, class: "form-check-input" %>
          <%= form.label :public_access, "Public", class: "form-check-label" %>
        </div>
        <div class="form-text text-12">Anyone with the link can view this thing without signing in.</div>
      </div>
    </div>
  </div>

  <div>
    <div class="h-section-label mb-2">Standard links</div>
    <p class="text-secondary text-13 mb-3">Optional links shared by every thing: Asset, Wiki, Slack, Where, and AR.</p>
    <div class="vstack gap-2">
      <% thing.standard_links.each do |link| %>
        <%= form.fields_for :links, link do |link_form| %>
          <%= link_form.hidden_field :link_type %>
          <div class="row g-2 align-items-end">
            <div class="col-md-7">
              <%= link_form.label :url, link.display_title, class: "form-label" %>
              <%= link_form.url_field :url, class: "form-control", placeholder: "https://" %>
            </div>
            <div class="col-md-5">
              <%= link_form.label :note, "Note", class: "form-label" %>
              <%= link_form.text_field :note, class: "form-control", placeholder: "Optional" %>
            </div>
          </div>
        <% end %>
      <% end %>
    </div>
  </div>

  <div data-controller="nested-form">
    <div class="h-section-label mb-2">Custom links</div>
    <div class="vstack gap-2" data-nested-form-target="container">
      <%= form.fields_for :links do |link_form| %>
        <% next unless link_form.object.link_custom? %>

        <%= render "custom_link_fields", form: link_form %>
      <% end %>
    </div>

    <template data-nested-form-target="template">
      <%= form.fields_for :links, ThingLink.new(link_type: :custom), child_index: "NEW_RECORD" do |link_form| %>
        <%= render "custom_link_fields", form: link_form %>
      <% end %>
    </template>

    <button type="button" class="btn btn-outline-secondary btn-sm mt-2" data-action="nested-form#add">
      + Add custom link
    </button>
    <p class="text-secondary text-12 mt-2 mb-0">Leave custom link fields blank to omit them.</p>
  </div>

  <div data-controller="related-things"
       data-related-things-search-url-value="<%= search_things_path(format: :json) %>"
       data-related-things-exclude-id-value="<%= thing.id if thing.persisted? %>">
    <div class="h-section-label mb-2">Related things</div>
    <p class="text-secondary text-13 mb-3">Link this thing to others, such as a mouse and its dongle. Relationships apply to both things.</p>

    <div class="vstack gap-2 mb-3" data-related-things-target="container">
      <%= form.fields_for :thing_relationships do |relationship_form| %>
        <%= render "related_thing_fields", form: relationship_form %>
      <% end %>
    </div>

    <template data-related-things-target="template">
      <%= form.fields_for :thing_relationships, ThingRelationship.new, child_index: "NEW_RECORD" do |relationship_form| %>
        <div class="row g-2 align-items-end" data-related-things-target="item">
          <%= relationship_form.hidden_field :related_thing_id, value: "__RELATED_ID__", data: { related_things_target: "relatedIdField" } %>
          <div class="col-md-4">
            <div class="form-label">Thing</div>
            <div class="text-13 fw-medium" data-related-things-target="name">__RELATED_NAME__</div>
          </div>
          <div class="col-md-7">
            <%= relationship_form.label :note, "Note", class: "form-label" %>
            <%= relationship_form.text_field :note, class: "form-control", placeholder: "Optional" %>
          </div>
          <div class="col-md-1">
            <label class="form-label d-none d-md-block">&nbsp;</label>
            <button type="button" class="btn btn-outline-secondary btn-sm w-100" data-action="related-things#remove" title="Remove">
              <i class="bi bi-x-lg"></i>
            </button>
          </div>
        </div>
      <% end %>
    </template>

    <div class="position-relative">
      <label class="form-label" for="related-things-search">Add related thing</label>
      <input type="search"
             id="related-things-search"
             class="form-control"
             placeholder="Search by name…"
             autocomplete="off"
             data-related-things-target="input"
             data-action="input->related-things#input keydown->related-things#keydown">
      <div class="list-group position-absolute w-100 d-none shadow-sm"
           style="z-index: 1050; max-height: 240px; overflow-y: auto;"
           data-related-things-target="results"></div>
    </div>
  </div>

  <div>
    <div class="h-section-label mb-2">AR Marker</div>
    <p class="text-secondary text-13 mb-3">Optional image marker printed at the end of labels for AR apps.</p>
    <% if thing.ar_anchor.attached? %>
      <div class="mb-3">
        <%= image_tag thing.ar_anchor, class: "img-fluid rounded border border-secondary-subtle", style: "max-height: 120px" %>
        <% if thing.persisted? %>
          <div class="mt-2">
            <%= link_to "Remove AR marker", ar_anchor_thing_path(thing),
                        class: "btn btn-outline-danger btn-sm",
                        data: { turbo_method: :delete, turbo_confirm: "Remove AR marker?" } %>
          </div>
        <% end %>
      </div>
    <% end %>
    <div class="row g-2 align-items-end">
      <div class="col-md-7">
        <%= form.label :ar_anchor, "Image", class: "form-label" %>
        <%= form.file_field :ar_anchor, accept: "image/jpeg,image/png,image/gif,image/webp", class: "form-control" %>
      </div>
      <div class="col-md-5">
        <%= form.label :ar_anchor_note, "Note", class: "form-label" %>
        <%= form.text_field :ar_anchor_note, class: "form-control", placeholder: "Optional" %>
      </div>
    </div>
  </div>

  <div>
    <div class="h-section-label mb-2">Photos</div>
    <% if thing.photos.attached? %>
      <div class="row g-2 mb-3">
        <% thing.photos.each do |photo| %>
          <div class="col-4 col-md-3">
            <%= image_tag photo, class: "img-fluid rounded border border-secondary-subtle w-100" %>
            <% if thing.persisted? %>
              <div class="mt-1">
                <%= link_to "Remove", photo_thing_path(thing, photo),
                            class: "btn btn-outline-danger btn-sm w-100",
                            data: { turbo_method: :delete, turbo_confirm: "Remove this photo?" } %>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
    <% end %>
    <%= form.label :photos, "Add photos", class: "form-label" %>
    <%= form.file_field :photos, multiple: true, accept: "image/jpeg,image/png,image/gif,image/webp", class: "form-control" %>
  </div>

  <div class="d-flex gap-2">
    <%= form.submit class: "btn btn-primary btn-sm" %>
    <%= link_to "Cancel", thing.persisted? ? thing_path(thing) : things_path, class: "btn btn-outline-secondary btn-sm" %>
    <% if thing.persisted? %>
      <%= link_to "Delete", thing_path(thing),
                  class: "btn btn-outline-danger btn-sm",
                  data: { turbo_method: :delete, turbo_confirm: "Delete #{thing.name}?" } %>
    <% end %>
  </div>
<% end %>
