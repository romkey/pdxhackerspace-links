<div class="modal fade" id="print-label-dialog" tabindex="-1" aria-labelledby="print-label-dialog-title" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header py-2">
        <h2 class="modal-title h6 mb-0" id="print-label-dialog-title" data-print-dialog-target="title">Print label</h2>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <%= form_with url: "#", method: :post, html: { class: "modal-body text-13", data: { print_dialog_target: "form", turbo: false } } do %>
        <div class="mb-3" data-print-dialog-target="bulkFields"></div>

        <div class="mb-3">
          <div class="h-section-label mb-2">Layout</div>
          <div class="d-flex flex-column gap-1">
            <% Things::LabelPdf::LAYOUTS.each do |layout| %>
              <div class="form-check">
                <%= radio_button_tag :layout, layout, layout == :standard,
                                     class: "form-check-input",
                                     id: "print-layout-#{layout}",
                                     data: {
                                       print_dialog_target: "layoutRadio",
                                       action: "change->print-dialog#layoutChanged"
                                     } %>
                <%= label_tag "print-layout-#{layout}", Things::LabelPdf.layout_label(layout), class: "form-check-label" %>
              </div>
            <% end %>
          </div>
          <div class="text-12 text-secondary mt-1 d-none" data-print-dialog-target="cableTagHint">
            Cable tags require an IP address or hostname.
          </div>
        </div>

        <div class="mb-3">
          <%= label_tag :printer_id, "Printer", class: "form-label text-12" %>
          <%= select_tag :printer_id,
                         options_from_collection_for_select(printers, :id, :name, printers.first&.id),
                         class: "form-select form-select-sm",
                         data: {
                           print_dialog_target: "printerSelect",
                           action: "change->print-dialog#printerChanged"
                         } %>
        </div>

        <div class="mb-3">
          <%= label_tag :copies, "Copies", class: "form-label text-12" %>
          <%= number_field_tag :copies, 1, min: 1, max: 99, class: "form-control form-control-sm", style: "max-width: 5rem" %>
        </div>

        <div class="form-check mb-0">
          <%= check_box_tag :mark_labelled, "1", true, class: "form-check-input", id: "print-mark-labelled" %>
          <%= label_tag "print-mark-labelled", "Mark as labelled", class: "form-check-label" %>
        </div>
      <% end %>
      <div class="modal-footer py-2">
        <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
        <button type="button"
                class="btn btn-outline-secondary btn-sm"
                data-print-dialog-target="previewButton"
                data-action="print-dialog#preview">
          Preview
        </button>
        <button type="button"
                class="btn btn-primary btn-sm"
                data-print-dialog-target="submitButton"
                data-action="print-dialog#submit">
          Print
        </button>
      </div>
    </div>
  </div>
</div>
