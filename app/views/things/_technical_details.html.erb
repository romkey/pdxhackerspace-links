<% groups = things_detail_groups(thing) %>
<% if groups.any? %>
  <section class="row g-4 mb-4">
    <% groups.each do |group| %>
      <div class="col-md-6 col-xl-3 detail-group">
        <div class="h-section-label mb-2"><%= group[:label] %></div>
        <dl class="detail-list">
          <% group[:rows].each do |row| %>
            <dt><%= row[:label] %></dt>
            <dd><%= render "things/detail_value", row: row %></dd>
          <% end %>
        </dl>
      </div>
    <% end %>
  </section>
<% end %>
