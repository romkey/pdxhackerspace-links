#!/usr/bin/env node
// Rebuilds CSS whenever an SCSS file under app/assets/stylesheets changes.
// Uses chokidar (v4+ has no braces dependency) rather than raw fs.watch, which
// on Linux tracks inodes and can lose files that editors save atomically.
// Set CHOKIDAR_USEPOLLING=1 if file events don't reach the container.
const { spawn } = require("node:child_process");
const path = require("node:path");

const dir = path.join(__dirname, "..", "app", "assets", "stylesheets");
let running = false;
let pending = false;
let timer = null;

function build() {
  if (running) {
    pending = true;
    return;
  }
  running = true;
  const child = spawn("yarn", ["build:css"], { stdio: "inherit" });
  child.on("exit", () => {
    running = false;
    if (pending) {
      pending = false;
      build();
    }
  });
}

function scheduleBuild() {
  clearTimeout(timer);
  timer = setTimeout(build, 100);
}

(async () => {
  const { watch } = await import("chokidar");

  build();
  watch(dir, {
    ignoreInitial: true,
    ignored: (file, stats) => stats?.isFile() && !file.endsWith(".scss"),
  }).on("all", (_event, file) => {
    if (file.endsWith(".scss")) scheduleBuild();
  });
  console.log(`Watching ${path.relative(process.cwd(), dir)} for SCSS changes...`);
})();
